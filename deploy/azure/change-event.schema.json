{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astronomy Shop deployment evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["deploymentId", "timestamp", "sourceRevision", "configDigest", "imageLockDigest", "resourceIds", "outcome"],
  "properties": {
    "deploymentId": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "sourceRevision": { "type": "string", "minLength": 40, "maxLength": 40 },
    "configDigest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "imageLockDigest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "resourceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "outcome": { "enum": ["provisioned", "verified", "failed"] },
    "traceId": { "type": "string", "minLength": 32, "maxLength": 32 },
    "checks": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
